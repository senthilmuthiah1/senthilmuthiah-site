---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config.js';
import { testimonials } from '../data/testimonials.js';

const sorted = [...testimonials].sort((a, b) => b.date.localeCompare(a.date));
const year = (d) => d.slice(0, 4);
---
<BaseLayout title={`Recommendations — ${SITE.name}`} description={`${testimonials.length} recommendations from clients and colleagues in US healthcare IT.`}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">Recommendations</h1>
      <p class="lede">What {testimonials.length} clients and colleagues say about working with me, from my LinkedIn profile.</p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Project enquiry')}`}>Discuss your project</a>
        <a class="btn btn-text" href={SITE.linkedin}>View on LinkedIn</a>
      </div>
    </header>
    <div class="quote-columns">
      {sorted.map((t) => (
        <figure class="quote">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.role}</span>
            <span class="quote-year">{year(t.date)}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</BaseLayout>
