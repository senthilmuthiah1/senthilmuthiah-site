---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <div class="wrap page-head" style="padding-bottom: 120px;">
    <h1 class="display">This page doesn't exist.</h1>
    <p class="lede">It may have moved. Try the homepage or the blog.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to homepage</a>
      <a class="btn btn-text" href="/blog/">Open the blog</a>
    </div>
  </div>
</BaseLayout>
