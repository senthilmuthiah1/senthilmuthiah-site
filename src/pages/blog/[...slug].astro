---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config.js';
import { getPublishedPosts, formatDate, tagSlug } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} — ${SITE.name}`} description={post.data.summary ?? SITE.description} image={post.data.cover}>
  <article class="wrap">
    <header class="post-head">
      <a href="/blog/" style="font-weight: 700; color: var(--accent);">Blog</a>
      <h1 class="display">{post.data.title}</h1>
      {post.data.summary && <p class="lede">{post.data.summary}</p>}
      <div class="tag-row">
        <time class="card-meta" datetime={post.data.date.toISOString()} style="margin-right: 8px; align-self: center;">{formatDate(post.data.date)}</time>
        {post.data.tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>{t}</a>)}
      </div>
    </header>
    {post.data.cover && <div class="post-cover"><img src={post.data.cover} alt="" /></div>}
    <div class="prose">
      <Content />
    </div>
    <aside class="archive-note post-archive">
      <p><strong>Keep learning:</strong> 15+ years of my earlier articles on medical billing, X12 EDI, EMR and Java are on my original blog, <a href={SITE.oldBlog}>emrpms.blogspot.com</a>. Watch my videos on <a href={SITE.youtube}>YouTube</a>, and connect with me on <a href={SITE.linkedin}>LinkedIn</a>.</p>
    </aside>
    <footer class="post-foot">
      <a href="/blog/">All posts</a>
      <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(post.data.title)}`}>Questions? Email me</a>
    </footer>
  </article>
</BaseLayout>
