---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config.js';
import { getPublishedPosts, formatDate, tagSlug } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').replace(/<!--[\s\S]*?-->/g, '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
---
<BaseLayout title={`${post.data.title} — ${SITE.name}`} description={post.data.summary ?? SITE.description} image={post.data.cover}>
  <article class="wrap">
    <header class="post-head">
      <a href="/blog/" style="font-weight: 700; color: var(--accent);">Blog</a>
      <h1 class="display">{post.data.title}</h1>
      {post.data.summary && <p class="lede">{post.data.summary}</p>}
      <div class="byline">
        {SITE.photo && <img class="byline-photo" src={SITE.photo} alt="" width="36" height="36" />}
        <span>By <a href="/#about">{SITE.name}</a></span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
      <div class="tag-row">
        {post.data.tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>{t}</a>)}
      </div>
    </header>
    {post.data.cover && <div class="post-cover"><img src={post.data.cover} alt="" /></div>}
    <div class="prose">
      <Content />
    </div>
    <aside class="author-box" aria-label="About the author">
      {SITE.photo && <img class="author-photo" src={SITE.photo} alt={SITE.name} width="96" height="96" loading="lazy" />}
      <div>
        <p class="author-name">{SITE.name}</p>
        <p class="author-bio">{SITE.years}+ years building EMR, PMS and billing systems for US healthcare. Creator of eClaimPilot. I write about medical billing, X12 EDI and EMR in plain English.</p>
        <p class="author-links">
          <a href={SITE.oldBlog}>My older blog</a>
          <a href={SITE.youtube}>YouTube</a>
          <a href={SITE.linkedin}>LinkedIn</a>
          <a href={SITE.product}>eClaimPilot</a>
        </p>
      </div>
    </aside>
    <footer class="post-foot">
      <a href="/blog/">All posts</a>
      <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(post.data.title)}`}>Questions? Email me</a>
    </footer>
  </article>
</BaseLayout>
