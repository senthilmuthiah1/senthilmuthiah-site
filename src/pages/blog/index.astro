---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import TagRow from '../../components/TagRow.astro';
import { SITE } from '../../site.config.js';
import { getPublishedPosts } from '../../lib/posts.js';

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<BaseLayout title={`Blog — ${SITE.name}`} description="Notes on EMR, PMS, LIS, medical billing and healthcare software development.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">Blog</h1>
      <p class="lede">Notes on EMR, PMS, LIS, medical billing and building healthcare software.</p>
      {tags.length > 0 && <TagRow tags={tags} />}
    </header>
    <PostList posts={posts} />
    <aside class="archive-note">
      <p>Looking for older articles? Years of posts on medical billing, EMR and EDI are in the <a href={SITE.oldBlog}>blog archive on emrpms.blogspot.com</a>.</p>
    </aside>
  </div>
</BaseLayout>
