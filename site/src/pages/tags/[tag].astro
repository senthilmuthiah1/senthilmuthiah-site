---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import TagRow from '../../components/TagRow.astro';
import { SITE } from '../../site.config.js';
import { getPublishedPosts, tagSlug } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, tags, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, tags, posts } = Astro.props;
---
<BaseLayout title={`${tag} — Blog — ${SITE.name}`} description={`Posts about ${tag}.`}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="display">{tag}</h1>
      <TagRow tags={tags} current={tag} />
    </header>
    <PostList posts={posts} />
  </div>
</BaseLayout>
