---
import { tagSlug } from '../lib/posts.js';
const { tags, current } = Astro.props;
---
<nav class="tag-row" aria-label="Topics">
  <a class="tag" href="/blog/" aria-current={!current ? 'page' : undefined}>All</a>
  {tags.map((t) => (
    <a class="tag" href={`/tags/${tagSlug(t)}/`} aria-current={current === t ? 'page' : undefined}>{t}</a>
  ))}
</nav>
